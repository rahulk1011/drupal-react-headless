{#
/**
 * @file maintenance-page.html.twig
 *
 * Branded maintenance page for react_theme.
 *
 * Used when Drupal is in maintenance mode and the request is a normal (HTML)
 * page view, i.e. the embedded React app is not reachable. Enable it with
 * $settings['maintenance_theme'] = 'react_theme'; in settings.php.
 *
 * API requests get a JSON 503 from apiservices instead; the standalone SPA
 * shows its own maintenance screen for those.
 *
 * Variables: page.content (the maintenance message), title, site_name, logo.
 */
#}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex" />
  <title>{{ title ?: 'Site under maintenance' }} | {{ site_name ?: 'Drupal React CMS' }}</title>
  <style>
    body {
      margin: 0;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #eef4fb;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      color: #2E3440;
    }
    .maintenance-card {
      max-width: 520px;
      margin: 24px;
      padding: 40px 32px;
      text-align: center;
      background: #ffffff;
      border: 1px solid #e5e7eb;
      border-radius: 12px;
      box-shadow: 0 10px 30px rgba(11, 46, 89, 0.08);
    }
    .maintenance-card img { width: 56px; height: 56px; }
    .maintenance-card h1 { margin: 12px 0; font-size: 28px; color: #0B2E59; }
    .maintenance-card p { margin: 0; font-size: 16px; line-height: 1.6; color: #6b7280; }
    .maintenance-card .icon { font-size: 40px; margin: 12px 0 8px; }
  </style>
</head>
<body>
  <div class="maintenance-card" role="main">
    {% if logo %}
      <img src="{{ logo }}" alt="" />
    {% endif %}
    <h1>{{ title ?: 'Site under maintenance' }}</h1>
    <p>{{ page.content }}</p>
		<div class="icon" aria-hidden="true">🛠</div>
  </div>
</body>
</html>
